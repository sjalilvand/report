// سامانه «سکوی هوشمند آماده‌سازی داده، مدل‌سازی و گزارش‌سازی»
// مدل اطلاعاتی مطابق بخش ۲۸ سند نیازمندی‌ها (نسخه MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// فضای کاری / پروژه — بخش ۶ سند (مرحله اول: ایجاد پروژه)
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  owner       String?
  domain      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  files       SourceFile[]
  datasets    Dataset[]
  reports     Report[]
  measures    MeasureDefinition[]
  auditEvents AuditEvent[]
  relations   Relation[]
}

// فایل منبع — SourceFile در بخش ۲۸ سند
model SourceFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  size        Int
  mimeType    String?
  fingerprint String // اثر انگشت محتوا برای تشخیص فایل تکراری (بخش ۷.۱)
  content     String // محتوای فایل به صورت Base64 (حفظ داده خام — بخش ۴)
  sheetInfo   String   @default("[]") // JSON: نام شیت‌ها و شناسایی اولیه
  uploadedBy  String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  datasets    Dataset[]

  @@unique([projectId, fingerprint])
  @@index([projectId])
}

// مجموعه‌داده آماده‌شده از یک شیت — Dataset و DatasetVersion در بخش ۲۸
model Dataset {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId         String
  file           SourceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  name           String
  sheetName      String
  headerRow      Int      @default(1) // سطر سرستون (بخش ۷.۱)
  firstDataRow   Int      @default(0)
  lastDataRow    Int      @default(0) // 0 یعنی تا پایان
  config         String   @default("{}") // JSON: پیکربندی (سیاست سلول ادغام‌شده، سطرهای حذف‌شده و ...)
  fields         String   @default("[]") // JSON: FieldMeta[] — مشخصات ستون‌ها (بخش ۸)
  records        String   @default("[]") // JSON: رکوردهای نسخه جاری (داده آماده‌شده)
  rowCount       Int      @default(0)
  grain          String? // سطح جزئیات داده — بخش ۱۱.۳
  currencyBase   String   @default("rial") // واحد ذخیره‌سازی مبنا — بخش ۱۴.۱
  version        Int      @default(1) // نسخه مجموعه‌داده — بخش ۲۴.۳
  transforms     String   @default("[]") // JSON: دفترچه مراحل تبدیل — بخش ۱۰.۳
  status         String   @default("draft") // draft | confirmed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reports        Report[]

  @@index([projectId])
}

// فیلد مشتق‌شده / سنجه محاسباتی — بخش ۱۲ و ۱۸ (فرهنگ داده)
model MeasureDefinition {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String // کد/نام شاخص
  label        String
  description  String? // تعریف مدیریتی
  formula      String // فرمول
  unit         String?
  aggregation  String   @default("sum") // نوع تجمیع — بخش ۱۱.۴
  datasetId    String? // جدول منبع
  owner        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

// گزارش — Report و ReportVersion و ReportComponent در بخش ۲۸
model Report {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  datasetId   String?
  dataset     Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  title       String
  description String?
  config      String   @default("{}") // JSON: اجزای گزارش (جدول، نمودار، کارت شاخص، فیلترها)
  status      String   @default("draft") // draft | pending | approved | published | rejected — گردش کار تأیید بخش ۲۶.۱
  createdBy   String?
  publishedAt DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvals   ApprovalEvent[]

  @@index([projectId])
}

// ثبت رویداد — AuditEvent در بخش ۲۸ (بخش ۴: ردیابی)
model AuditEvent {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// کاربر سامانه — بخش ۲.۲ (کاربران هدف) و بخش ۲۹ (کنترل دسترسی مبتنی بر نقش)
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  passwordHash String    // هش scrypt با نمک تصادفی
  role         String    @default("viewer") // admin | steward | analyst | viewer | auditor — بخش ۵ سند
  rowRules     String    @default("[]") // JSON: قواعد دسترسی سطح سطر [{datasetId, fieldId, op, value}] — بخش ۲۹
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([role])
}

// نشست ورود — بخش ۲۹ (احراز هویت امن، ابطال دسترسی)
model Session {
  id        String   @id @default(cuid()) // توکن تصادفی نشست
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// رابطه بین جداول — بخش ۱۶ سند (محیط بصری اتصال جداول)
model Relation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  fromDatasetId   String
  toDatasetId     String
  cardinality     String   @default("many-to-one") // one-to-one | one-to-many | many-to-one | many-to-many — بخش ۱۶.۱
  joinType        String   @default("left") // inner | left | right | full | anti | append — بخش ۱۶.۲
  columnPairs     String   @default("[]") // JSON: [{fromFieldId, toFieldId}] — کلید ساده یا مرکب
  status          String   @default("active") // suggested | active | rejected — پذیرش/رد پیشنهاد سامانه
  filterDirection String   @default("single") // single | both — جهت اثر فیلترها — بخش ۱۶.۳
  lastCheck       String? // JSON: نتیجه آخرین کنترل پیش از اتصال — بخش ۱۶.۳
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

// رویداد گردش کار تأیید گزارش — بخش ۲۶.۱ و ۳۶ (گردش کار تأیید گزارش)
model ApprovalEvent {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action     String // submit | approve | reject | publish | unpublish
  fromStatus String
  toStatus   String
  comment    String?
  actor      String
  role       String?
  createdAt  DateTime @default(now())

  @@index([reportId])
}

// پیکربندی سامانه و سقف ظرفیت — بخش ۳۰.۱ (کارایی و ظرفیت) و ۳۶ (تصمیم‌های پیش از قرارداد)
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
