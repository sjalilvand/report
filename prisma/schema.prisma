// سامانه «سکوی هوشمند آماده‌سازی داده، مدل‌سازی و گزارش‌سازی»
// مدل اطلاعاتی مطابق بخش ۲۸ سند نیازمندی‌ها (نسخه MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// فضای کاری / پروژه — بخش ۶ سند (مرحله اول: ایجاد پروژه)
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  owner       String?
  domain      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  files       SourceFile[]
  datasets    Dataset[]
  reports     Report[]
  measures    MeasureDefinition[]
  auditEvents AuditEvent[]
  relations   Relation[]
  alertRules  AlertRule[]
  notifications Notification[]
  occasions   Occasion[]
  connections ExternalConnection[]
  jobs        Job[]
}

// فایل منبع — SourceFile در بخش ۲۸ سند
model SourceFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  size        Int
  mimeType    String?
  fingerprint String // اثر انگشت محتوا برای تشخیص فایل تکراری (بخش ۷.۱)
  content     String // محتوای فایل به صورت Base64 (حفظ داده خام — بخش ۴)
  sheetInfo   String   @default("[]") // JSON: نام شیت‌ها و شناسایی اولیه
  uploadedBy  String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  datasets    Dataset[]

  @@unique([projectId, fingerprint])
  @@index([projectId])
}

// مجموعه‌داده آماده‌شده از یک شیت — Dataset و DatasetVersion در بخش ۲۸
model Dataset {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId         String? // برای داده واردشده از منبع خارجی (اتصال پایگاه‌داده/API — بخش ۳۱) فایل منبع وجود ندارد
  file           SourceFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  name           String
  sheetName      String
  headerRow      Int      @default(1) // سطر سرستون (بخش ۷.۱)
  firstDataRow   Int      @default(0)
  lastDataRow    Int      @default(0) // 0 یعنی تا پایان
  config         String   @default("{}") // JSON: پیکربندی (سیاست سلول ادغام‌شده، سطرهای حذف‌شده و ...)
  fields         String   @default("[]") // JSON: FieldMeta[] — مشخصات ستون‌ها (بخش ۸)
  records        String   @default("[]") // JSON: رکوردهای نسخه جاری (داده آماده‌شده)
  rowCount       Int      @default(0)
  grain          String? // سطح جزئیات داده — بخش ۱۱.۳
  currencyBase   String   @default("rial") // واحد ذخیره‌سازی مبنا — بخش ۱۴.۱
  version        Int      @default(1) // نسخه مجموعه‌داده — بخش ۲۴.۳
  transforms     String   @default("[]") // JSON: دفترچه مراحل تبدیل — بخش ۱۰.۳
  status         String   @default("draft") // draft | confirmed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reports        Report[]
  alertRules     AlertRule[]

  @@index([projectId])
}

// فرهنگ داده — شاخص مرکزی قابل استفاده مجدد — بخش ۱۸ سند
// هر شاخص: نام و کد، تعریف مدیریتی، فرمول، جدول و ستون منبع، واحد، نوع تجمیع،
// فیلترهای ثابت، دامنه کاربرد، مالک، نسخه، تاریخ تأیید و محدودیت‌ها
model MeasureDefinition {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String // کد/نام شاخص
  label        String
  description  String? // تعریف مدیریتی (مثال سند: «تعداد افراد» یعنی تعداد رکورد یا شناسه متمایز؟)
  formula      String    @default("") // فرمول (در صورت محاسباتی بودن)
  datasetId    String? // جدول و ستون منبع
  sourceFieldId String? // ستون منبع
  unit         String?
  aggregation  String    @default("sum") // نوع تجمیع — بخش ۱۱.۴
  fixedFilters String    @default("[]") // JSON: فیلترهای ثابت شاخص — بخش ۱۸
  scope        String? // دامنه کاربرد
  owner        String? // مالک شاخص
  limitations  String? // محدودیت‌ها
  status       String    @default("draft") // draft | approved — شاخص تأییدشده در گزارش‌ها قابل استفاده مجدد است
  version      Int       @default(1)
  approvedAt   DateTime? // تاریخ تأیید
  approvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

// گزارش — Report و ReportVersion و ReportComponent در بخش ۲۸
model Report {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  datasetId   String?
  dataset     Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  title       String
  description String?
  config      String   @default("{}") // JSON: اجزای گزارش (جدول، نمودار، کارت شاخص، فیلترها)
  status      String   @default("draft") // draft | pending | approved | published | rejected — گردش کار تأیید بخش ۲۶.۱
  createdBy   String?
  publishedAt DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvals   ApprovalEvent[]

  @@index([projectId])
}

// ثبت رویداد — AuditEvent در بخش ۲۸ (بخش ۴: ردیابی)
model AuditEvent {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// کاربر سامانه — بخش ۲.۲ (کاربران هدف) و بخش ۲۹ (کنترل دسترسی مبتنی بر نقش)
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  passwordHash String    // هش scrypt با نمک تصادفی
  role         String    @default("viewer") // admin | steward | analyst | viewer | auditor — بخش ۵ سند
  rowRules     String    @default("[]") // JSON: قواعد دسترسی سطح سطر [{datasetId, fieldId, op, value}] — بخش ۲۹
  active       Boolean   @default(true)
  // ورود یکپارچه سازمانی (SSO) و احراز هویت چندمرحله‌ای (MFA) — بخش ۲۹ سند
  ssoSubject   String?   @unique // شناسه یکتای کاربر در سامانه هویتی سازمان (sub در OIDC)
  mfaSecret    String? // کلید TOTP (Base32) — تا پیش از فعال‌سازی فقط پیش‌نویس است
  mfaEnabled   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  mfaTickets   MfaTicket[]

  @@index([role])
}

// نشست ورود — بخش ۲۹ (احراز هویت امن، ابطال دسترسی)
model Session {
  id        String   @id @default(cuid()) // توکن تصادفی نشست
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// بلیت واسط ورود دوعاملی — بخش ۲۹ سند (احراز هویت چندمرحله‌ای برای نقش‌های حساس)
// پس از تأیید گذرواژه، اگر کاربر MFA فعال دارد، این بلیت کوتاه‌عمر صادر و با کد TOTP مبادله می‌شود
model MfaTicket {
  id        String   @id @default(cuid()) // توکن تصادفی تک‌مصرف
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// منبع داده خارجی — بخش ۳۱ سند («اتصال API و پایگاه‌داده» — اختیاری / مرحله توسعه)
// انواع: api (سرویس REST/JSON) | postgres | mysql
// همگام‌سازی دستی یا زمان‌بندی‌شده: داده به مجموعه‌داده پروژه منتقل و نسخه‌بندی می‌شود
model ExternalConnection {
  id                  String    @id @default(cuid())
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  type                String // api | postgres | mysql
  config              String    @default("{}") // JSON — پیکربندی اتصال؛ مقادیر محرمانه در پاسخ ماسک می‌شوند
  query               String? // پرس‌وجوی فقط‌خواندنی SQL یا مسیر پاسخ API
  syncIntervalMinutes Int       @default(0) // 0 = فقط همگام‌سازی دستی
  status              String    @default("untested") // untested | ok | error
  lastMessage         String? // آخرین پیام وضعیت یا علت خطا
  lastSyncAt          DateTime?
  lastSyncRows        Int       @default(0)
  datasetId           String? // مجموعه‌داده مقصد — در همگام‌سازی بعدی جایگزین می‌شود
  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([projectId])
}

// پردازش پس‌زمینه — Job و Export در بخش ۲۸ و پایداری ۳۰.۲ سند (صف خروجی حجیم)
// خروجی‌های حجیم به‌صورت غیرهم‌زمان تولید می‌شوند؛ بازیابی پردازش شکست‌خورده،
// اجرای مجدد امن، ثبت مدت و علت شکست و انقضای لینک دانلود در همین مدل پشتیبانی می‌شود
model Job {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // export.xlsx | export.csv | export.pdf | export.pptx
  status      String    @default("queued") // queued | running | done | failed | canceled
  progress    Int       @default(0) // 0..100
  payload     String    @default("{}") // JSON: مشخصات خروجی + قواعد سطح سطر درخواست‌کننده
  result      String? // JSON: {fileName, size, mime, expiresAt}
  error       String? // علت شکست — بخش ۳۰.۲ (ثبت علت)
  attempts    Int       @default(0) // تعداد اجرا — اجرای مجدد امن (بخش ۳۰.۲)
  maxAttempts Int       @default(2)
  createdBy   String?
  durationMs  Int? // مدت اجرا — بخش ۳۰.۲ (ثبت مدت)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([status])
}

// رابطه بین جداول — بخش ۱۶ سند (محیط بصری اتصال جداول)
model Relation {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  fromDatasetId   String
  toDatasetId     String
  cardinality     String   @default("many-to-one") // one-to-one | one-to-many | many-to-one | many-to-many — بخش ۱۶.۱
  joinType        String   @default("left") // inner | left | right | full | anti | append — بخش ۱۶.۲
  columnPairs     String   @default("[]") // JSON: [{fromFieldId, toFieldId}] — کلید ساده یا مرکب
  status          String   @default("active") // suggested | active | rejected — پذیرش/رد پیشنهاد سامانه
  filterDirection String   @default("single") // single | both — جهت اثر فیلترها — بخش ۱۶.۳
  lastCheck       String? // JSON: نتیجه آخرین کنترل پیش از اتصال — بخش ۱۶.۳
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

// رویداد گردش کار تأیید گزارش — بخش ۲۶.۱ و ۳۶ (گردش کار تأیید گزارش)
model ApprovalEvent {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action     String // submit | approve | reject | publish | unpublish
  fromStatus String
  toStatus   String
  comment    String?
  actor      String
  role       String?
  createdAt  DateTime @default(now())

  @@index([reportId])
}

// پیکربندی سامانه و سقف ظرفیت — بخش ۳۰.۱ (کارایی و ظرفیت) و ۳۶ (تصمیم‌های پیش از قرارداد)
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// قاعده هشدار — بخش ۲۶.۲ سند (هشدار و اعلان)
// محرک‌ها: threshold (عبور شاخص از آستانه) | quality (کاهش کیفیت داده)
//          fileDelay (تأخیر در دریافت فایل) | processFailure (شکست پردازش)
//          structureChange (تغییر ساختار) | missingPeriod (نبود داده در دوره مورد انتظار)
model AlertRule {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  datasetId   String?
  dataset     Dataset?      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  fieldId     String? // ستون سنجه برای threshold
  aggregation String        @default("sum") // sum | avg | count | min | max | countDistinct
  operator    String        @default("gt") // gt | lt | gte | lte | eq
  threshold   Float? // آستانه (threshold و quality و کمینه رکورد مورد انتظار missingPeriod)
  maxDays     Int? // حداکثر فاصله مجاز روز برای fileDelay
  severity    String        @default("warning") // info | warning | critical
  active      Boolean       @default(true)
  createdBy   String?
  lastEvalAt  DateTime?
  lastState   String? // JSON: خروجی آخرین ارزیابی (مقدار، امضای ساختار و ...)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  notifications Notification[]

  @@index([projectId])
  @@index([active])
}

// اعلان تولیدشده — بخش ۲۶.۲ سند (درون‌برنامه‌ای؛ کانال ایمیل در فازهای بعد)
model Notification {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ruleId     String?
  rule       AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  type       String // threshold | quality | fileDelay | processFailure | structureChange | missingPeriod | info
  severity   String     @default("warning") // info | warning | critical
  title      String
  message    String
  entityType String? // dataset | report | file | rule
  entityId   String?
  value      Float? // مقدار مشاهده‌شده در لحظه هشدار
  read       Boolean    @default(false)
  readAt     DateTime?
  createdAt  DateTime   @default(now())

  @@index([projectId, read])
  @@index([ruleId])
  @@index([createdAt])
}

// تقویم مناسبت‌ها — بخش ۱۵.۴ سند
// جدول مرجع مناسبت‌ها: نام، نوع تقویم، شروع/پایان در هر سال، دسته، سراسری/محلی،
// تعطیل/غیرتعطیل، منبع و نسخه، رنگ و برچسب نمایشی
// مناسبت قمری: تاریخ متناظر باید بر اساس مرجع تقویمی مورد تأیید سازمان، سال‌به‌سال ثبت شود
model Occasion {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  calendarType String   @default("shamsi")  // shamsi | ghamari | miladi — نوع تقویم
  year         String?  // سال ثبت (شمسی، مثلاً ۱۴۰۴) — برای قمری: سال متناظر مرجع تأییدشده
  startDate    String   // تاریخ شروع YYYY-MM-DD در همان تقویم
  endDate      String?  // تاریخ پایان (اختیاری — برای دوره‌های چندروزه)
  category     String   @default("official") // official | religious | organizational | other — دسته مناسبت
  scope        String   @default("global")   // global | local — سراسری یا محلی
  isHoliday    Boolean  @default(false)      // تعطیل یا غیرتعطیل
  source       String?  // منبع اطلاعات
  sourceVersion String? // نسخه اطلاعات
  color        String   @default("#2563eb")  // رنگ نمایشی
  label        String?  // برچسب نمایشی
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, year])
}
